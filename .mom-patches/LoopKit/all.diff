+
+public struct BasalScheduleProfileChart: View {
+    @Environment(\.insulinTintColor) private var insulinTintColor
+
+    private let items: [RepeatingScheduleValue<Double>]
+
+    public init(items: [RepeatingScheduleValue<Double>]) {
+        self.items = items.sorted { $0.startTime < $1.startTime }
+    }
+
+    private struct Segment: Identifiable {
+        let id: TimeInterval
+        let startHour: Double
+        let endHour: Double
+        let rate: Double
+    }
+
+    private var segments: [Segment] {
+        guard !items.isEmpty else { return [] }
+
+        return items.enumerated().map { index, item in
+            let startHour = item.startTime / .hours(1)
+            let endHour = index + 1 < items.count
+                ? items[index + 1].startTime / .hours(1)
+                : 24
+            return Segment(id: item.startTime, startHour: startHour, endHour: endHour, rate: item.value)
+        }
+    }
+
+    private var totalDailyDose: Double {
+        segments.reduce(0) { $0 + $1.rate * ($1.endHour - $1.startHour) }
+    }
+
+    private var maxRate: Double {
+        max(segments.map(\.rate).max() ?? 1, 0.5)
+    }
+
+    public var body: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            HStack(alignment: .firstTextBaseline) {
+                Text(LocalizedString("24-Hour Profile", comment: "Title for basal schedule graph"))
+                    .font(.subheadline)
+                    .bold()
+                Spacer()
+                Text(String(format: LocalizedString("%.2f U/day", comment: "Format for total daily scheduled basal"), totalDailyDose))
+                    .font(.subheadline)
+                    .foregroundColor(.secondary)
+            }
+
+            if segments.isEmpty {
+                Text(LocalizedString("Add rates to see the daily graph.", comment: "Empty-state text for basal schedule graph"))
+                    .font(.footnote)
+                    .foregroundColor(.secondary)
+                    .frame(maxWidth: .infinity, minHeight: 120, alignment: .center)
+            } else {
+                GeometryReader { geometry in
+                    let plotHeight = geometry.size.height - 22
+                    let plotWidth = geometry.size.width
+                    ZStack(alignment: .bottomLeading) {
+                        ForEach([0.25, 0.5, 0.75, 1.0], id: \.self) { fraction in
+                            Path { path in
+                                let y = plotHeight * (1 - fraction)
+                                path.move(to: CGPoint(x: 0, y: y))
+                                path.addLine(to: CGPoint(x: plotWidth, y: y))
+                            }
+                            .stroke(Color.secondary.opacity(0.2), lineWidth: 1)
+                        }
+
+                        HStack(alignment: .bottom, spacing: 0) {
+                            ForEach(segments) { segment in
+                                let width = plotWidth * (segment.endHour - segment.startHour) / 24
+                                let height = plotHeight * (segment.rate / maxRate)
+                                VStack(spacing: 0) {
+                                    Spacer(minLength: 0)
+                                    RoundedRectangle(cornerRadius: 3, style: .continuous)
+                                        .fill(insulinTintColor)
+                                        .frame(height: max(height, segment.rate > 0 ? 3 : 0))
+                                }
+                                .frame(width: max(width - 1.5, 1), height: plotHeight, alignment: .bottom)
+                            }
+                        }
+
+                        Text(String(format: LocalizedString("%.2f U/hr", comment: "Y-axis label for the highest basal rate on the graph"), maxRate))
+                            .font(.caption2)
+                            .foregroundColor(.secondary)
+                            .offset(y: -plotHeight + 12)
+                    }
+                    .frame(height: plotHeight, alignment: .bottom)
+                }
+                .frame(height: 132)
+
+                HStack {
+                    Text(LocalizedString("12a", comment: "Midnight label on basal schedule graph"))
+                    Spacer()
+                    Text(LocalizedString("6a", comment: "6 AM label on basal schedule graph"))
+                    Spacer()
+                    Text(LocalizedString("12p", comment: "Noon label on basal schedule graph"))
+                    Spacer()
+                    Text(LocalizedString("6p", comment: "6 PM label on basal schedule graph"))
+                    Spacer()
+                    Text(LocalizedString("12a", comment: "Next midnight label on basal schedule graph"))
+                }
+                .font(.caption2)
+                .foregroundColor(.secondary)
+            }
+        }
+        .accessibilityElement(children: .combine)
+        .accessibilityLabel(Text(LocalizedString("Basal schedule graph", comment: "Accessibility label for basal schedule graph")))
+        .accessibilityValue(Text(String(format: LocalizedString("%.2f units per day", comment: "Accessibility value for total daily basal"), totalDailyDose)))
+    }
+}
